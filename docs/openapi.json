        ]
      },
      "get": {
        "description": "Lista eventos com paginação HATEOAS. Pode filtrar por comunidade, modalidade e status",
        "operationId": "EventController_getAll",
        "parameters": [
          {
            "name": "take",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros",
            "schema": {
              "example": 25,
              "type": "number"
            }
          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros para pular",
            "schema": {
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "communityId",
            "required": false,
            "in": "query",
            "description": "Filtrar por ID da comunidade",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "modality",
            "required": false,
            "in": "query",
            "description": "Filtrar por modalidade",
            "schema": {
              "enum": [
                "ONLINE",
                "PRESENCIAL",
                "HIBRIDO"
              ],
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "description": "Filtrar por status ativo/inativo",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de eventos retornada com sucesso com links de navegação"
          }
        },
        "summary": "Listar todos os eventos",
        "tags": [
          "events"
        ]
      }
    },
