            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros para pular",
            "schema": {
              "example": 0,
              "type": "number"
            }
