{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "module": {
    "type": "es6"
  },
  "jsc": {
    "target": "es2022",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@common/*": ["src/common/*"],
      "@module/*": ["src/module/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@configs/*": ["src/configs/*"],
      "@decorators/*": ["src/decorators/*"],
      "@helper/*": ["src/helper/*"],
      "@db/*": ["src/prisma/*"],
      "@interface/*": ["src/interface/*"],
      "@seed-data/*": ["prisma/seed/data/*"]
    }
  }
}
