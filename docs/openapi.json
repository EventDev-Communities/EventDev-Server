  "info": {
    "title": "EventDev API",
    "description": "API RESTful para gerenciamento de eventos e comunidades com autorização baseada em papéis e permissões",
    "version": "1.0",
    "contact": {
      "name": "EventDev Team",
      "url": "https://eventdev.org",
      "email": "contact@eventdev.org"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "authentication",
      "description": "Autenticação e autorização de usuários"
    },
    {
      "name": "communities",
      "description": "Gerenciamento de comunidades organizadoras"
    },
    {
      "name": "events",
      "description": "Gerenciamento de eventos"
    },
    {
      "name": "tickets",
      "description": "Gerenciamento de ingressos e tickets"
    },
    {
      "name": "addresses",
      "description": "Gerenciamento de endereços"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:5122",
      "description": "API Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Token de autenticação JWT do SuperTokens",
        "in": "header"
      }
    },
    "schemas": {
      "CreateCommunityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tech Community Brasil",
            "description": "Nome da comunidade"
          },
          "description": {
            "type": "string",
            "example": "Comunidade focada em tecnologia"
          },
          "logoUrl": {
            "type": "string",
            "example": "https://example.com/logo.png"
          },
          "phoneNumber": {
            "type": "string",
            "example": "11987654321"
          },
          "instagramLink": {
            "type": "string",
            "example": "https://instagram.com/techcommunity"
          },
          "linkedinLink": {
            "type": "string",
            "example": "https://linkedin.com/company/techcommunity"
          },
          "websiteLink": {
            "type": "string",
            "example": "https://techcommunity.dev"
          },
          "githubLink": {
            "type": "string",
            "example": "https://github.com/techcommunity"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "ownerId": {
            "type": "string",
            "example": "user_123456",
            "description": "ID do usuário dono da comunidade"
          }
        },
        "required": [
          "name",
          "ownerId"
        ]
      },
      "UpdateCommunityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tech Community Brasil",
            "description": "Nome da comunidade"
          },
          "description": {
            "type": "string",
            "example": "Comunidade focada em tecnologia"
          },
          "logoUrl": {
            "type": "string",
            "example": "https://example.com/logo.png"
          },
          "phoneNumber": {
            "type": "string",
            "example": "11987654321"
          },
          "instagramLink": {
            "type": "string",
            "example": "https://instagram.com/techcommunity"
          },
          "linkedinLink": {
            "type": "string",
            "example": "https://linkedin.com/company/techcommunity"
          },
          "websiteLink": {
            "type": "string",
            "example": "https://techcommunity.dev"
          },
          "githubLink": {
            "type": "string",
            "example": "https://github.com/techcommunity"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "ownerId": {
            "type": "string",
            "example": "user_123456",
            "description": "ID do usuário dono da comunidade"
          }
        }
      },
      "InviteCommunityDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@techcommunity.com",
            "description": "Email do futuro dono da comunidade"
          },
          "name": {
            "type": "string",
            "example": "Tech Community Brasil",
            "description": "Nome da comunidade"
          },
          "description": {
            "type": "string",
            "example": "Comunidade focada em tecnologia"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email do usuário"
          },
          "password": {
            "type": "string",
            "example": "Password@123",
            "description": "Senha do usuário"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email do usuário para recuperação de senha"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "token-xyz-123",
            "description": "Token de redefinição de senha recebido por email"
          },
          "password": {
            "type": "string",
            "example": "NewPassword123!",
            "description": "Nova senha do usuário"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "UserSignUpDto": {
        "type": "object",
        "properties": {}
      },
      "CommunitySignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "community@example.com",
            "description": "Email da comunidade"
          },
          "name": {
            "type": "string",
            "example": "Tech Community Brasil",
            "description": "Nome da comunidade"
          },
          "description": {
            "type": "string",
            "example": "Comunidade focada em tecnologia"
          },
          "logoUrl": {
            "type": "string",
            "example": "https://example.com/logo.png"
          },
          "phoneNumber": {
            "type": "string",
            "example": "11987654321"
          },
          "instagramLink": {
            "type": "string",
            "example": "https://instagram.com/techcommunity"
          },
          "linkedinLink": {
            "type": "string",
            "example": "https://linkedin.com/company/techcommunity"
          },
          "websiteLink": {
            "type": "string",
            "example": "https://techcommunity.dev"
          },
          "githubLink": {
            "type": "string",
            "example": "https://github.com/techcommunity"
          },
          "role": {
            "type": "string",
            "example": "community",
            "enum": [
              "user",
              "community"
            ],
            "description": "Tipo de conta"
          }
        },
        "required": [
          "email",
          "name",
          "role"
        ]
      },
      "AcceptInviteDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token de convite recebido por email"
          },
          "password": {
            "type": "string",
            "example": "StrongP@ssw0rd!",
            "description": "Senha para a nova conta"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {}
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "cep": {
            "type": "string",
            "example": "01310100",
            "description": "CEP (8 dígitos)"
          },
          "state": {
            "type": "string",
            "example": "SP"
          },
          "city": {
            "type": "string",
            "example": "São Paulo"
          },
          "neighborhood": {
            "type": "string",
            "example": "Bela Vista"
          },
          "streetAddress": {
            "type": "string",
            "example": "Avenida Paulista"
          },
          "number": {
            "type": "string",
            "example": "1578"
          }
        },
        "required": [
          "cep"
        ]
      },
      "CreateTicketTypeDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateTicketTypeDto": {
        "type": "object",
        "properties": {}
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}