{
  "name": "eventdev-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build && tsc-alias",
    "start": "node --import tsx/esm dist/src/main.js",
    "start-dev": "cross-env TSX_TSC=1 tsx watch src/main.ts",
    "start-debug": "cross-env TSX_TSC=1 node --inspect=0.0.0.0:9229 --import tsx/esm --watch src/main.ts",
    "start-prod": "node --import tsx/esm dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "format": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "docs-generate": "npx prisma generate >/dev/null 2>&1 && npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script 2>&1 | grep -E '^(--|CREATE|ALTER|DROP)' > docs/schema.sql && echo 'Schemas gerados! Para gerar openapi.json execute: pnpm start-dev'",
    "test": "jest --runInBand --detectOpenHandles",
    "test-watch": "jest --runInBand --watch",
    "test-cov": "jest --runInBand --coverage",
    "test-debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest-e2e": "node tools/testing/prepare-test-db.mjs",
    "test-e2e": "jest --config ./test/jest-e2e.json --testTimeout=20000",
    "pretest-e2e-debug": "node tools/testing/prepare-test-db.mjs",
    "test-e2e-debug": "jest --config ./test/jest-e2e.json --testTimeout=20000 --detectOpenHandles",
    "prepare-test-db": "node tools/testing/prepare-test-db.mjs",
    "migrate-prod": "prisma migrate deploy",
    "seed-prod": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertokens-nestjs": "^0.0.5",
    "supertokens-node": "^22.1.1",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@dotenvx/dotenvx": "^1.51.1",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.46.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "pg": "^8.13.1",
    "prisma-dbml-generator": "^0.12.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "imports": {
    "#/*": "./dist/src/*",
    "#common/*": "./dist/src/common/*",
    "#module/*": "./dist/src/module/*",
    "#infrastructure/*": "./dist/src/infrastructure/*",
    "#configs/*": "./dist/src/configs/*",
    "#decorators/*": "./dist/src/decorators/*",
    "#helper/*": "./dist/src/helper/*",
    "#prisma/*": "./dist/src/prisma/*",
    "#interface/*": "./dist/src/interface/*"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@module/(.*)$": "<rootDir>/module/$1",
      "^@configs/(.*)$": "<rootDir>/configs/$1",
      "^@decorators/(.*)$": "<rootDir>/decorators/$1",
      "^@helper/(.*)$": "<rootDir>/helper/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@interface/(.*)$": "<rootDir>/interface/$1",
      "^@prisma/(?!client)(.*)$": "<rootDir>/prisma/$1",
      "^@seed-data/(.*)$": "<rootDir>/../prisma/seed/data/$1"
    }
  }
}
