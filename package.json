{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "eventdev-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.3",
    "pnpm": ">=10.23.0"
  },
  "imports": {
    "#*": "./dist/*",
    "#common/*": "./dist/common/*",
    "#module/*": "./dist/module/*",
    "#infrastructure/*": "./dist/infrastructure/*",
    "#configs/*": "./dist/configs/*",
    "#decorators/*": "./dist/decorators/*",
    "#helper/*": "./dist/helper/*",
    "#db/*": "./dist/prisma/*",
    "#interface/*": "./dist/interface/*",
    "#seed-data/*": "./dist/prisma/seed/data/*"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --import @swc-node/register/esm-register dist/main.js",
    "start-dev": "nest start --watch --exec 'node --import @swc-node/register/esm-register'",
    "start-debug": "cross-env TSX_TSC=1 node --inspect=0.0.0.0:9229 --import @swc-node/register/esm-register --watch src/main.ts",
    "start-prod": "node --import @swc-node/register/esm-register dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "format": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "docs-generate": "npx prisma generate --no-hints >/dev/null 2>&1 && npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script 2>&1 | grep -E '^(--|CREATE|ALTER|DROP)' > docs/schema.sql && echo 'Schemas gerados! Para gerar openapi.json execute: pnpm start-dev'",
    "generate-http": "node --import @swc-node/register/esm-register docs/rest-client/tools/generate-http.ts",
    "simulate-webhook": "node --import @swc-node/register/esm-register tools/simulate-webhook.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test-watch": "jest --runInBand --watch",
    "test-cov": "jest --runInBand --coverage --coverageDirectory=test/coverage",
    "test-debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest-e2e": "node --import @swc-node/register/esm-register test/setup/prepare-test-db.ts",
    "test-e2e": "jest --config ./test/jest-e2e.json --testTimeout=20000 --runInBand",
    "pretest-e2e-debug": "node --import @swc-node/register/esm-register test/setup/prepare-test-db.ts",
    "test-e2e-debug": "jest --config ./test/jest-e2e.json --testTimeout=20000 --detectOpenHandles",
    "test-all": "pnpm test && pnpm test-e2e",
    "prepare-test-db": "node --import @swc-node/register/esm-register test/setup/prepare-test-db.ts",
    "migrate-prod": "prisma migrate deploy",
    "seed": "prisma db seed",
    "verify-all": "pnpm lint && pnpm test-all && pnpm build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cross-env": "^10.1.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "mercadopago": "^2.10.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertokens-nestjs": "^0.0.5",
    "supertokens-node": "^22.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@swc/cli": "^0.7.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prisma-dbml-generator": "^0.12.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.47.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts",
      "!src/metadata.ts",
      "!test/**"
    ],
    "coverageDirectory": "./test/coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@module/(.*)$": "<rootDir>/src/module/$1",
      "^@configs/(.*)$": "<rootDir>/src/configs/$1",
      "^@decorators/(.*)$": "<rootDir>/src/decorators/$1",
      "^@helper/(.*)$": "<rootDir>/src/helper/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@interface/(.*)$": "<rootDir>/src/interface/$1",
      "^@db/prisma.service$": "<rootDir>/src/prisma/prisma.service",
      "^@db/prisma.module$": "<rootDir>/src/prisma/prisma.module",
      "^@seed-data/(.*)$": "<rootDir>/prisma/seed/data/$1"
    },
    "snapshotResolver": "./test/setup/snapshot-resolver.ts",
    "roots": [
      "<rootDir>/test/unit"
    ]
  }
}
