    "/api/v1/events": {
      "post": {
        "description": "Cria um novo evento para a comunidade do usuário autenticado",
        "operationId": "EventController_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Evento criado com sucesso"
          },
          "403": {
            "description": "Usuário não tem permissão de comunidade"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Criar novo evento",
        "tags": [
          "events"
        ]
      },
      "get": {
        "description": "Lista eventos com paginação HATEOAS. Pode filtrar por comunidade, modalidade e status",
        "operationId": "EventController_getAll",
        "parameters": [
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "description": "Filtrar por status ativo/inativo",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "modality",
            "required": false,
            "in": "query",
            "description": "Filtrar por modalidade",
            "schema": {
              "enum": [
                "ONLINE",
                "PRESENCIAL",
                "HIBRIDO"
              ],
              "type": "string"
            }
          },
          {
            "name": "communityId",
            "required": false,
            "in": "query",
            "description": "Filtrar por ID da comunidade",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros para pular",
            "schema": {
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "take",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros",
            "schema": {
              "example": 25,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de eventos retornada com sucesso com links de navegação"
          }
        },
        "summary": "Listar todos os eventos",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "operationId": "EventController_getByID",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dados do evento"
          },
          "404": {
            "description": "Evento não encontrado"
          }
        },
        "summary": "Buscar evento por ID",
        "tags": [
          "events"
        ]
      },
      "patch": {
        "description": "Atualiza um evento existente. Apenas o dono da comunidade pode atualizar seus eventos",
        "operationId": "EventController_update",
        "parameters": [
          {
            "name": "idAddress",
            "required": false,
            "in": "query",
            "description": "ID do endereço (se estiver atualizando)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evento atualizado com sucesso"
          },
          "403": {
            "description": "Sem permissão para atualizar este evento"
          },
          "404": {
            "description": "Evento não encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Atualizar evento",
        "tags": [
          "events"
        ]
      },
      "delete": {
        "description": "Remove um evento. Apenas o dono da comunidade pode deletar seus eventos",
        "operationId": "EventController_delete",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Evento deletado com sucesso"
          },
          "403": {
            "description": "Sem permissão para deletar este evento"
          },
          "404": {
            "description": "Evento não encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Deletar evento",
        "tags": [
          "events"
        ]
      }
    },
