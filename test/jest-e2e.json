{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "roots": ["<rootDir>/test/e2e"],
  "setupFiles": ["<rootDir>/test/setup/setup-e2e.ts"],
  "testTimeout": 15000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "coverageDirectory": "test/coverage",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1",
    "^@module/(.*)$": "<rootDir>/src/module/$1",
    "^@configs/(.*)$": "<rootDir>/src/configs/$1",
    "^@decorators/(.*)$": "<rootDir>/src/decorators/$1",
    "^@helper/(.*)$": "<rootDir>/src/helper/$1",
    "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
    "^@interface/(.*)$": "<rootDir>/src/interface/$1",
    "^@db/(.*)$": "<rootDir>/src/prisma/$1",
    "^@seed-data/(.*)$": "<rootDir>/prisma/seed/data/$1"
  },
  "snapshotResolver": "<rootDir>/test/setup/snapshot-resolver.ts",
  "maxWorkers": 3
}
