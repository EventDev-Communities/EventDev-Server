    "/api/v1/communities": {
      "get": {
        "description": "Lista comunidades ativas com paginação HATEOAS e filtros",
        "operationId": "CommunityController_getAll",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Buscar por nome ou descrição",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "description": "Filtrar por status ativo/inativo",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros para pular",
            "schema": {
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "take",
            "required": false,
            "in": "query",
            "description": "Quantidade de registros",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de comunidades retornada com sucesso com links de navegação"
          }
        },
        "summary": "Listar todas as comunidades",
        "tags": [
          "communities"
        ]
      },
      "post": {
        "description": "Cria uma nova comunidade para o usuário autenticado",
        "operationId": "CommunityController_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Comunidade criada com sucesso"
          },
          "403": {
            "description": "Usuário não tem permissão para criar comunidade"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Criar nova comunidade",
        "tags": [
          "communities"
        ]
      }
    },
    "/api/v1/communities/me": {
      "get": {
        "description": "Retorna os dados da comunidade do usuário autenticado",
        "operationId": "CommunityController_getMyCommunity",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dados da comunidade retornados com sucesso"
          },
          "403": {
            "description": "Usuário não tem perfil de comunidade"
          },
          "404": {
            "description": "Comunidade não encontrada"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Obter minha comunidade",
        "tags": [
          "communities"
        ]
      }
    },
    "/api/v1/communities/{id}": {
      "get": {
        "operationId": "CommunityController_getByID",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dados da comunidade"
          },
          "404": {
            "description": "Comunidade não encontrada"
          }
        },
        "summary": "Buscar comunidade por ID",
        "tags": [
          "communities"
        ]
      },
      "patch": {
        "description": "Atualiza os dados da comunidade. Apenas o dono pode atualizar",
        "operationId": "CommunityController_update",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Comunidade atualizada com sucesso"
          },
          "403": {
            "description": "Sem permissão para atualizar esta comunidade"
          },
          "404": {
            "description": "Comunidade não encontrada"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Atualizar comunidade",
        "tags": [
          "communities"
        ]
      },
      "delete": {
        "description": "Remove uma comunidade. Apenas o dono pode deletar",
        "operationId": "CommunityController_delete",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Comunidade deletada com sucesso"
          },
          "403": {
            "description": "Sem permissão para deletar esta comunidade"
          },
          "404": {
            "description": "Comunidade não encontrada"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Deletar comunidade",
        "tags": [
          "communities"
        ]
      }
    },
    "/api/v1/auth/signin": {
      "post": {
        "description": "Realiza login com email e senha. Retorna dados do usuário e seus papéis",
